-- Throwaway Prosody for experiment E16. @WORK@ is replaced by run.sh.
pidfile = "@WORK@/prosody.pid"
data_path = "@WORK@/data"
interfaces = { "127.0.0.1" }
admins = { }
modules_enabled = { "disco"; "roster"; "saslauth"; "tls"; "ping"; "mam"; "carbons"; "smacks"; "csi_simple"; "http" }
modules_disabled = { "s2s"; "posix" }
c2s_ports = { }
c2s_direct_tls_ports = { 15223 }
c2s_require_encryption = true
allow_unencrypted_plain_auth = false
authentication = "internal_hashed"
ssl = { key = "@WORK@/pki/srv.key"; certificate = "@WORK@/pki/srv.pem" }
http_ports = { 15280 }
https_ports = { }
http_interfaces = { "127.0.0.1" }
log = { info = "@WORK@/prosody.log" }
VirtualHost "localhost"
Component "rooms.localhost" "muc"
  modules_enabled = { "muc_mam" }
  restrict_room_creation = false
  muc_room_default_public_jids = true
  muc_log_all_rooms = true
Component "upload.localhost" "http_file_share"
  -- The file-share HTTP routes are per host: without this the PUT answers 404.
  http_host = "localhost"
  http_external_url = "http://localhost:15280/"
  http_file_share_size_limit = 5 * 1024 * 1024
